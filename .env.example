# Application identity
BOT_NAME=Koto Satsuki
BOT_MODE=production
BOT_VERSION=1.0.0
BOT_LANGUAGE=JavaScript
BOT_LIBRARY=Baileys

# Creator identity (optional)
CREATOR_NAME=
CREATOR_CONTACT_URL=

# Owner identity
OWNER_NAME=Nama Owner
OWNER_NUMBER=628xxxxxxxxxx
OWNER_CONTACT_URL=

# WhatsApp newsletter context (use the actual newsletter JID)
BOT_CHANNEL_ID=
BOT_CHANNEL_NAME=
BOT_CHANNEL_SERVER_MESSAGE_ID=100

# General configuration
COMMAND_PREFIX=.
TIMEZONE=Asia/Jakarta
LANGUAGE=id

# WhatsApp connection
WHATSAPP_PHONE_NUMBER=628xxxxxxxxxx
SESSION_FOLDER=./storage/Sessions
GROUP_CONFIG_PATH=./storage/group-config.json
WHATSAPP_DATA_PATH=./storage/whatsapp-data.json
WHATSAPP_DATA_COLLECTION_ENABLED=false
WHATSAPP_DATA_RETENTION_DAYS=30

# System
LOG_LEVEL=info
RECONNECT_BASE_DELAY_MS=3000
RECONNECT_MAX_DELAY_MS=30000
RECONNECT_JITTER=true

# Menu media
MENU_IMAGE_PATH=./assets/menu.jpg
MENU_IMAGE_ENABLED=true
